<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cash Hub NG - Earn</title>
<link rel="stylesheet" href="style.css">
<style>
body{
    font-family:Arial,sans-serif;
    background:#f5f5f5;
    margin:0;
    padding:20px;
}
.container{
    max-width:800px;
    margin:auto;
}
.card{
    background:#fff;
    border-radius:10px;
    padding:15px;
    margin-bottom:20px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
}
button{
    width:100%;
    padding:15px;
    background:#16a34a;
    color:#fff;
    border:none;
    border-radius:8px;
    font-size:18px;
}
iframe{
    width:100%;
    height:800px;
    border:none;
    margin-top:20px;
}
</style>
</head>

<body>

<div class="container">

<div class="card">
<h2>Earn Money</h2>
<p>Complete surveys and offers to earn rewards.</p>

<button onclick="openOfferwall()">
Open CPX Offerwall
</button>

<div id="offerwall"></div>

</div>

</div>

<script>
function openOfferwall(){

document.getElementById("offerwall").innerHTML=`
<iframe
src="https://offers.cpx-research.com/index.php?app_id=34986">
</iframe>
`;

}
</script>

</body>
</html>
